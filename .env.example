# Never put real secrets in this file.
# Put real values in Render -> Environment.

NODE_ENV=production
DATABASE_URL=postgresql://example
SESSION_SECRET=replace-with-64-random-characters
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated. Include your Render URL now; add dcurs.org later.
ALLOWED_ORIGINS=https://your-service.onrender.com

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
